# DeliveryKit 共通のコード分析設定。
#
# **このファイルは.NETを含む全リポジトリに同じものが置かれている。**
# 1か所にまとめられないのは、機能ごとにリポジトリを分けており、
# D:\repos\DeliveryKit\ 直下がGit管理外のため共通の親を持てないことによる。
# **片方だけ直すとリポジトリ間でずれる。** 変えるときは全リポジトリへ同じ変更を入れ、
# `find . -name .editorconfig` の数と.NETリポジトリの数を突き合わせること
# （DeliveryKit.slnxからモジュールが半分抜けていたのと同じ抜け方をする）。
root = true

[*.cs]
# **未使用のprivateメンバーを警告にする。**
#
# コンパイラは未使用のprivateフィールドをCS0169で警告するが、
# **未使用のprivateメソッド・プロパティには何も言わない。** 呼ばれない
# メソッドは「この処理は行われている」と読まれるので、残っていると
# 次に読む人を誤らせる（ARCHITECTURE.md 12章「名前どおりに動いていない機能」）。
#
# IDE0051/IDE0052 は既定では重大度が提案止まりでビルドに出ない。
# ここで警告へ上げ、Directory.Build.props の EnforceCodeStyleInBuild と対で効く
# （**どちらか片方だけでは出ない。** 導入時に実際に未使用メンバーを
# 入れて出ることを確かめてある）。
#
# **errorではなくwarningにしてある。** 各リポジトリのci.ymlは素の `dotnet build`
# なので、**この警告ではCIは落ちない**——気づく場所はVisual Studioのエラー一覧と
# ビルド出力になる。errorにすれば止められるが、この規則は反射・シリアライズ・
# [Conditional]・EF Coreの経路で誤検出する形が知られており、**誤検出1件で
# 31リポジトリのビルドが止まる**ほうが、見落とし1件より重い。
# 導入時点の検出件数は全リポジトリで0件（実測）。
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
