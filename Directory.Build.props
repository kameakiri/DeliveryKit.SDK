<Project>

  <!--
    コードスタイル分析（IDE****）をビルドで有効にする。

    **.editorconfig とこのファイルは対で効く。** .editorconfig で
    IDE0051/IDE0052 の重大度を警告へ上げても、このプロパティが無いと
    IDE系アナライザ自体がビルドで動かないため何も出ない（逆も同じ）。
    導入時に実際に未使用のprivateメソッドを入れ、両方揃ったときだけ
    警告が出ることを確かめてある。

    **このファイルも全.NETリポジトリに同じものが置かれている。**
    理由と注意は .editorconfig の冒頭を参照。
  -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    既知の脆弱性があるNuGetパッケージでビルドを落とす。

    **以前は警告のままで、誰も見ていなかった（脆弱性の棚卸しで発覚）。**
    NU1902/NU1903 は .NET 8 以降なら既定で出るが、警告はビルドを止めないので
    CIのログに流れていくだけだった。実際 SixLabors.ImageSharp の勧告5件が
    毎回出ていて、気づいたのは棚卸しで手元で脆弱なパッケージの一覧を
    出したときである。JavaScript側も同じ状態で、
    紹介サイトの本番依存に critical が溜まっていた
    （DeliveryKit.E2ETest/scripts/check-npm-audit-baseline.mjs）。

    NuGetAuditMode=all で推移的な依存も見る。**今この構成で問題が出るのは
    PdfSharpCore 経由の ImageSharp だけで、それは据え置くと決めてある。**
    据え置きは「NU1902 を全部黙らせる」ではなく、
    **勧告のURLを1件ずつ NuGetAuditSuppress で指名して**行う
    （DeliveryKit.Api.csproj 参照）。そうしないと、同じプロジェクトに
    将来別の脆弱なパッケージが入ったときに一緒に黙る。

    落ちたときは、まず上げられるか確かめること。上げられない場合は
    **なぜ安全なのかを csproj に書いてから**勧告を指名して抑制する。
  -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

</Project>
